  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit": "audit-ci --config ./audit-ci.jsonc",
    "bundle-size": "node scripts/bundle-size.mjs measure && node scripts/bundle-size.mjs report",
